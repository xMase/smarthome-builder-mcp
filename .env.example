# =============================================================================
# node-red-homeassistant-mcp — configuration template
# -----------------------------------------------------------------------------
# Copy this file to `.env` and edit it:   cp .env.example .env
#
# `.env` is auto-loaded when you run the server FROM the project directory, and
# can be passed to Docker with `docker run --env-file .env ...`.
# (When Claude Code launches the stdio server its working dir differs, so for
#  that path pass these as `-e KEY=VALUE` on the `claude mcp add` line instead.)
#
# Every variable is OPTIONAL — the defaults shown below are what the server uses.
# =============================================================================

# -----------------------------------------------------------------------------
# Node-RED Admin API  —  where the server reads and writes flows
# -----------------------------------------------------------------------------
# Base URL of your Node-RED instance.
NR_URL=http://localhost:1880

# Authentication, tried in this order:  token  ->  NR_USER/NR_PASS  ->  none.
# Leave all three empty for an unsecured Node-RED (e.g. a fresh throwaway one).
NR_TOKEN=                 # Bearer token (a Node-RED adminAuth token)
NR_USER=                  # Node-RED login username (for the HA add-on: your HA username)
NR_PASS=                  # Node-RED login password (for the HA add-on: your HA password)
NR_AUTH=basic             # How NR_USER/NR_PASS are used:
#   basic (default) — sent as HTTP Basic auth on every request.  Use this for the
#                     Home Assistant Node-RED add-on: nginx fronts Node-RED with
#                     Basic auth (realm "Home Assistant Authentication") using your
#                     HA credentials, so POST /auth/token never reaches Node-RED.
#   token           — exchange NR_USER/NR_PASS for a bearer via POST /auth/token
#                     on the first API call.  Use this for a vanilla Node-RED with
#                     adminAuth configured.

# TLS verification for https Node-RED URLs. Set to 0 (or false) for self-signed certs.
NR_VERIFY_SSL=1

# -----------------------------------------------------------------------------
# Safety  —  how flow deploys are applied
# -----------------------------------------------------------------------------
# propose : mutating tools return a PREVIEW (diff) and write NOTHING unless you
#           call them again with confirm=true.  (recommended; default)
# auto    : mutating tools write immediately (still backup-first).
DEPLOY_MODE=propose

# Directory where a JSON snapshot of the current flows is written before EVERY
# real deploy (so you can list/restore via nr_list_backups / nr_restore_backup).
BACKUP_DIR=./backups

# -----------------------------------------------------------------------------
# Transport  —  how the MCP client reaches this server
# -----------------------------------------------------------------------------
# stdio : the MCP client launches the process locally.  (default)
# http  : run as a long-lived service; streamable-HTTP served at http://HOST:PORT/mcp
#         (this is what the Docker image and the Portainer stack use).
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=0.0.0.0     # bind address in http mode (0.0.0.0 = all interfaces)
MCP_HTTP_PORT=8080        # port in http mode
